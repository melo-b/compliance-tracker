# Copy to .env for local development. Never commit the real .env file.
# docker-compose reads SECRET_KEY from this file too.

# REQUIRED. At least 32 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL connection string (docker-compose maps the db service to host port 5433)
DATABASE_URL=postgresql://postgres:password123@localhost:5433/compliance_db

# Optional: direct (non-pooled) connection used only by Alembic migrations. Set this when
# DATABASE_URL points at a connection pooler such as Neon's "-pooler" hostname.
# MIGRATION_DATABASE_URL=

# Redis broker for the optional Celery worker
CELERY_BROKER_URL=redis://localhost:6379/0
